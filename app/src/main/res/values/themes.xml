<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Splash theme — uses splashscreen API -->
    <style name="Theme.Jyotix.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/navy_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_jyotix_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Jyotix</item>
    </style>

    <style name="Theme.Jyotix" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/navy_background</item>
        <item name="android:statusBarColor">@color/navy_background</item>
        <item name="android:navigationBarColor">@color/navy_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
    </style>
</resources>
